# Content OS canonical free operation mode.
# Browser API keys are forbidden. Search reads central backdata only.
# Firebase is forbidden.

# Optional server-side override for the already-approved central collector.
# If unset, the canonical COMMON_LIBRARY_COLLECTOR fallback is used.
CONTENT_OS_BACKEND_URL=
CONTENT_OS_BACKEND_TOKEN=

# Google AdSense monetization.
# Keep empty until the verified AdSense publisher ID is confirmed for this site.
# Example format only: ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# Comma-separated paths where ads must not load.
VITE_ADSENSE_EXCLUDED_PATHS=/login,/settings,/privacy,/terms,/api

# No VITE_YOUTUBE_API_KEY / VITE_GEMINI_API_KEY / Firebase configuration in Content OS.
# External AI final-cooking is handled by the central ChatGPT workflow, not this runtime.
