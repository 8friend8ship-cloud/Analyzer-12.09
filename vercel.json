{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "test/**": false,
      "feat/**": false,
      "fix/**": false,
      "codex/**": false
    }
  },
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" }
  ]
}
